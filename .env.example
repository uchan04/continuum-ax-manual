# ── OpenRouter (브리핑 생성) ──────────────────────────────────────────────
# https://openrouter.ai/keys 에서 발급.
# VITE_ 접두사를 붙이지 마세요. 붙이면 키가 브라우저 번들에 그대로 노출됩니다.
OPENROUTER_API_KEY=

# 선택. 비우면 google/gemma-4-31b-it:free 를 씁니다.
# 무료 모델 목록: curl -s https://openrouter.ai/api/v1/models | grep -o '"id":"[^"]*:free"'
# 무료 모델은 usage.cost 가 0으로 찍히므로, 실제 건당 원가를 재려면
# 유료 모델(예: google/gemini-2.5-flash)로 바꿔 한 번 측정하세요.
OPENROUTER_MODEL=

# ── 검증 응답 수집 ────────────────────────────────────────────────────────
# 비워두면 응답은 각 브라우저의 localStorage 에만 남고,
# 완료 화면의 "응답 내보내기 (JSON)" 으로 직접 회수해야 합니다.
# 구글 시트로 받으려면 Apps Script 를 웹 앱으로 배포하고
# (doPost 에서 e.postData.contents 를 시트에 append) 그 URL 을 넣으세요.
VITE_COLLECTOR_URL=
